{
  "schema_version": 1,
  "required_timeframe": "5m",
  "required_sequence_length": 64,
  "required_feature_count": 27,
  "required_serving_symbols": ["BTCUSDT", "ETHUSDT"],
  "minimum_aligned_unique_bars_per_symbol": 100,
  "float64_scaler_max_abs_error": 1e-12,
  "float32_scaler_max_abs_error": 1e-7,
  "probability_max_abs_error": 1e-8,
  "regression_output_max_abs_error": 1e-7,
  "flat_output_std_threshold": 0.002,
  "extreme_low_threshold": 0.05,
  "extreme_high_threshold": 0.95,
  "extreme_consecutive_limit": 20,
  "flat_window": 30,
  "maximum_missing_rate": 0.05,
  "minimum_candidate_validation_auc": 0.55,
  "require_time_ordered_split": true,
  "require_purged_split": true,
  "require_scaler_fit_train_only": true,
  "require_dataset_digest": true,
  "require_feature_digest": true,
  "require_label_digest": true,
  "require_versioned_candidate_artifacts": true,
  "allow_incumbent_artifact_overwrite": false
}
